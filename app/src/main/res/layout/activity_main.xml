<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="تطبيق الحذف التلقائي والأرشفة المحلية لواتساب v2.2"
            android:textSize="19sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/autoDeleteSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/auto_delete_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/deferLockedSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/defer_when_locked_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/hideNotifLockedSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/hide_notif_locked_toggle" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/returnHomeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/return_home_toggle" />

        <EditText
            android:id="@+id/targetEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/target_hint"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#CCCCCC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/lan_section_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/lanUploadSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/lan_upload_toggle" />

        <EditText
            android:id="@+id/lanUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lan_url_hint"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/lanTokenEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/lan_token_hint"
            android:inputType="textVisiblePassword" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/testLanBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/test_lan" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#CCCCCC" />

        <Button
            android:id="@+id/openNlsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_nls" />

        <Button
            android:id="@+id/openA11yBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_a11y" />

        <Button
            android:id="@+id/openOverlayBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_overlay" />

        <Button
            android:id="@+id/openBatteryBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_battery" />

        <Button
            android:id="@+id/openContactsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/enable_contacts" />

        <Button
            android:id="@+id/testBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/test_manual" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#11888888"
            android:padding="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/logs_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refreshLogBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/refresh_logs" />

            <Button
                android:id="@+id/clearLogBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear_logs" />
        </LinearLayout>

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:padding="10dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ملاحظات مهمة: أدخل رقم الهاتف (مع أو بدون رمز الدولة) وامنح إذن جهات الاتصال للتعرّف التلقائي على الاسم المحفوظ. إذا كانت الشاشة مقفلة برمز PIN أو بصمة، يتم رفع الرسالة للشبكة المحلية فوراً وحفظها في طابور الحذف المؤجّل لتُحذف تلقائياً فور فتح القفل. أما إذا كان الهاتف بدون قفل آمن، فيوقظ التطبيق الشاشة ويحذف مباشرة."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
